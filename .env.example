# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Local (non-Docker) defaults
DATABASE_URL=postgresql+asyncpg://coach:coach@localhost:5432/coach
REDIS_URL=redis://localhost:6379/0

# Auth: required outside dev. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
ENVIRONMENT=dev

# MODEL_PROFILE=free uses config/models.free.yaml (Groq free tier, only GROQ_API_KEY needed)
# MODEL_PROFILE=free
